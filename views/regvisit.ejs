<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Nikita Kirpikin, veebiprogrammeerimine</title>
</head>
<body>
	<img src="pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
	<h1>Registreeri oma külastus</h1>
	
	<!-- Siin kuvame viimase külastuse infot, kui see on olemas -->
	<% if (typeof lastVisitText !== 'undefined' && lastVisitText) { %>
		<p><strong><%= lastVisitText %></strong></p>
	<% } else { %>
		<p>Külastusi pole veel registreeritud.</p>
	<% } %>

	<ul>
		<li><a href="/">Avalehele</a></li>
	</ul>
	<hr>
	<form method="POST">
		<label for="nameInput">Sinu eesnimi: </label>
		<input id="nameInput" name="nameInput" type="text" placeholder="Sinu eesnimi ...">
		<input id="nameSubmit" name="nameSubmit" type="submit" value="Salvesta">
	</form>
	<hr>
</body>
</html>